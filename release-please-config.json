{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "signalk-lint",
      "changelog-path": "CHANGELOG.md",
      "versioning": "always-bump-patch",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "draft": false,
      "prerelease": false,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Changed",
          "hidden": true
        }
      ]
    }
  }
}
